# ─── Database ────────────────────────────────────────────────────────────────
# Supabase session-pooler URL (port 5432). Replace with your project credentials.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Set True only when using pgBouncer transaction-mode pooler (port 6543)
DB_USE_NULLPOOL=False

# ─── Security ────────────────────────────────────────────────────────────────
# At least 32 random bytes. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-32-plus-char-random-string

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development    # development | staging | production
DEBUG=True                 # Must be False in production

# ─── Groq / OpenAI-compatible LLM (RAG chatbot) ──────────────────────────────
# Get a Groq API key at https://console.groq.com
OPENAI_API_KEY=gsk_...
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ─── CORS (production) ───────────────────────────────────────────────────────
# Comma-separated list of extra allowed origins added on top of the localhost defaults.
# Set this to your Vercel frontend URL on Render.
# Example: CORS_EXTRA_ORIGINS=https://churniq.vercel.app,https://churniq-git-main-dharshan.vercel.app
CORS_EXTRA_ORIGINS=
